# OCP Lab environment
# Copy this file to .env and fill in your key. Never commit .env.

# DeepSeek API key (server-side). Get one at https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Model to use. deepseek-chat is fast and cheap; deepseek-reasoner is stronger/slower.
DEEPSEEK_MODEL=deepseek-chat

# Optional: override the cost rates (USD per 1,000,000 tokens) used to estimate spend.
# Leave unset to use the built-in per-model defaults.
# DEEPSEEK_PRICE_INPUT=0.27
# DEEPSEEK_PRICE_OUTPUT=1.10
# DEEPSEEK_PRICE_CACHE_INPUT=0.07

# Port for the local server (default 4321).
PORT=4321
