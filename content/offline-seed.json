        "t2-count-vowels": {
          "code": "class Solution {\n    static int countVowels(String s) {\n      int count = 0;\n      for (char c : s.toLowerCase()) {\n        if (\"aeiouy\".contains(c)) {\n          ++count;\n        }\n      }\n      return count;\n    }\n}"
        },
        "t2-normalize-space": {
          "code": "class Solution {\n    static String normalize(String s) {\n        return s.strip().replaceAll('\\s', ' ');\n    }\n}"
        },
        "t2-reverse-words": {
          "code": "class Solution {\n    static String reverseWords(String s) {\n        String[] arr = s.split(\" \").reverse();\n        return arr.join(\" \");\n    }\n}"
        }
